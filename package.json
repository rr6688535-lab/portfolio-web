{
    "name":  "portfolio-web",
    "version":  "2.0.0",
    "private":  true,
    "description":  "Portfolio project with React frontend and Django backend",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "backend:venv":  "python -m venv backend/.venv",
                    "backend:install":  "backend/.venv/Scripts/pip install -r backend/requirements.txt",
                    "backend:migrate":  "backend/.venv/Scripts/python backend/manage.py migrate",
                    "backend:run":  "backend/.venv/Scripts/python backend/manage.py runserver",
                    "backend:worker":  "backend/.venv/Scripts/celery -A core worker -l info"
                },
    "dependencies":  {
                         "framer-motion":  "^11.11.10",
                         "gsap":  "^3.12.5",
                         "lucide-react":  "^1.16.0",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-router-dom":  "^6.30.1",
                         "three":  "^0.167.1",
                         "nodemailer":  "^6.9.14"
                     },
    "devDependencies":  {
                            "@vitejs/plugin-react":  "^4.3.1",
                            "autoprefixer":  "^10.4.20",
                            "postcss":  "^8.4.47",
                            "tailwindcss":  "^3.4.13",
                            "vite":  "^5.4.8"
                        }
}
