# Required
SECRET_KEY=replace-with-a-strong-django-secret

# Host and security
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional Django SMTP settings (only if backend mail endpoints are used)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=your_email@gmail.com
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Optional baseline rating
BASELINE_RATING_AVG=4.7
BASELINE_RATING_COUNT=7
